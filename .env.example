# Host the app is served from (used to build links/URLs).
HOST=localhost

# Force HTTPS redirects (set to true when running behind TLS).
FORCE_SSL=false

# ── White-label in Docker ─────────────────────────────────────────────
# docker compose reads this .env automatically. These pick which client a
# container serves, from the private config submodule (config/whitelabel).
# Change the two paths to switch client, then `docker compose up -d`.
INTEBEC_CONFIG_FILE=./config/whitelabel/clients/intebec.yml
INTEBEC_BRAND_DIR=./config/whitelabel/brands

# API / dashboard config mode instead of a file (optional): drop the config
# volume in docker-compose.yml and set these instead.
# INTEBEC_LICENCE_KEY=
# INTEBEC_SECRET_KEY=

# ── Local dev (bin/rails server, not Docker) ──────────────────────────
# Not needed: config/whitelabel/clients is auto-detected when the submodule
# is present. Set only to point at a different configs location.
# INTEBEC_CLIENTS_DIR=config/whitelabel/clients

# Fail to boot on an invalid client config (recommended for CI/deploys).
# INTEBEC_STRICT_CONFIG=true
