# Host the app is served from (used to build links/URLs).
HOST=localhost

# Force HTTPS redirects (set to true when running behind TLS).
FORCE_SSL=false

# ── White-label in Docker ─────────────────────────────────────────────
# docker compose reads this .env automatically. These pick which client a
# container serves, from the private config submodule (config/whitelabel).
# Change the two paths to switch client, then `docker compose up -d`.
INTEBEC_CONFIG_FILE=./config/whitelabel/clients/intebec.yml
INTEBEC_BRAND_DIR=./config/whitelabel/brands

