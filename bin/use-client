#!/usr/bin/env bash
#
# use-client — switch the active local white-label config (development).
#
# Symlinks config/config.yml -> config/clients/<name>.yml so the app (which
# loads config/config.yml by default in dev) picks up that client's branding.
# Restart the server after switching — the config is cached at boot.
#
# Usage:
#   bin/use-client <name>      Activate config/clients/<name>.yml
#   bin/use-client --list      List available client configs (marks the active one)
#   bin/use-client --current   Print the currently active client
#   bin/use-client --clear     Remove the config/config.yml symlink
#   bin/use-client --help      Show this help
#
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Where client configs live (first match wins):
#   1. INTEBEC_CLIENTS_DIR  (explicit override; relative => repo root)
#   2. config/whitelabel/clients  (private submodule, auto-detected)
#   3. config/clients             (in-repo default)
# Auto-detection means nobody has to export anything once the submodule exists.
if [[ -n "${INTEBEC_CLIENTS_DIR:-}" ]]; then
  case "$INTEBEC_CLIENTS_DIR" in
    /*) CLIENTS_DIR="$INTEBEC_CLIENTS_DIR" ;;
    *)  CLIENTS_DIR="$ROOT/$INTEBEC_CLIENTS_DIR" ;;
  esac
elif [[ -d "$ROOT/config/whitelabel/clients" ]]; then
  CLIENTS_DIR="$ROOT/config/whitelabel/clients"
else
  CLIENTS_DIR="$ROOT/config/clients"
fi
LINK="$ROOT/config/config.yml"

usage() { sed -n '3,18p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

list_clients() {
  local found=0
  shopt -s nullglob
  for f in "$CLIENTS_DIR"/*.yml; do
    found=1
    local name marker=""
    name="$(basename "$f" .yml)"
    if [[ -L "$LINK" && "$(readlink "$LINK")" == *"$(basename "$f")" ]]; then
      marker="  <- active"
    fi
    printf '  %s%s\n' "$name" "$marker"
  done
  shopt -u nullglob
  if [[ "$found" -eq 0 ]]; then
    echo "  (none yet — copy config/config.example.yml into config/clients/<name>.yml)"
  fi
}

current_client() {
  if [[ -L "$LINK" ]]; then
    basename "$(readlink "$LINK")" .yml
  elif [[ -e "$LINK" ]]; then
    echo "(config/config.yml is a regular file, not a managed symlink)"
  else
    echo "(none)"
  fi
}

case "${1:-}" in
  ""|-h|--help)
    usage
    ;;
  --list|-l)
    echo "Available client configs in ${CLIENTS_DIR#"$ROOT/"}:"
    list_clients
    ;;
  --current|-c)
    echo "Active client: $(current_client)"
    ;;
  --clear)
    if [[ -L "$LINK" ]]; then
      rm "$LINK"
      echo "Removed config/config.yml symlink."
    elif [[ -e "$LINK" ]]; then
      echo "Refusing to remove config/config.yml — it is a regular file, not a symlink." >&2
      exit 1
    else
      echo "No config/config.yml to clear."
    fi
    ;;
  -*)
    echo "Unknown option: $1" >&2
    echo >&2
    usage >&2
    exit 1
    ;;
  *)
    NAME="$1"
    TARGET="$CLIENTS_DIR/$NAME.yml"
    if [[ ! -f "$TARGET" ]]; then
      echo "No such client config: $TARGET" >&2
      echo >&2
      echo "Available:" >&2
      list_clients >&2
      exit 1
    fi
    if [[ -e "$LINK" && ! -L "$LINK" ]]; then
      echo "config/config.yml exists and is NOT a symlink — refusing to overwrite it." >&2
      echo "Move or remove it first if you want bin/use-client to manage it." >&2
      exit 1
    fi
    # Absolute target so it resolves regardless of where CLIENTS_DIR points.
    ln -sfn "$TARGET" "$LINK"
    echo "Active client -> $NAME  (config/config.yml -> $TARGET)"
    echo "Restart the server to apply."
    ;;
esac
