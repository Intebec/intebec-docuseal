#!/usr/bin/env bash
#
# use-client — switch the active local white-label config (development).
#
# Points config/config.yml at config/<clients>/<name>.yml so the app (which
# loads config/config.yml by default in dev) picks up that client's branding.
# Uses a symlink where the OS supports it, and falls back to a copy otherwise
# (e.g. Git Bash / MSYS on Windows). The active client is tracked in
# config/.active-client so switching works the same on every platform.
# Restart the server after switching — the config is cached at boot.
#
# NOTE: this only affects `bin/rails server` in dev. In Docker the active
# client is set by INTEBEC_CONFIG_FILE in .env, not by this script.
#
# Usage:
#   bin/use-client <name>      Activate <clients-dir>/<name>.yml
#   bin/use-client --list      List available client configs (marks the active one)
#   bin/use-client --current   Print the currently active client
#   bin/use-client --clear     Remove the managed config/config.yml
#   bin/use-client --help      Show this help
#
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Where client configs live (first match wins):
#   1. INTEBEC_CLIENTS_DIR  (explicit override; relative => repo root)
#   2. config/whitelabel/clients  (private submodule, auto-detected)
#   3. config/clients             (in-repo default)
if [[ -n "${INTEBEC_CLIENTS_DIR:-}" ]]; then
  case "$INTEBEC_CLIENTS_DIR" in
    /*) CLIENTS_DIR="$INTEBEC_CLIENTS_DIR" ;;
    *)  CLIENTS_DIR="$ROOT/$INTEBEC_CLIENTS_DIR" ;;
  esac
elif [[ -d "$ROOT/config/whitelabel/clients" ]]; then
  CLIENTS_DIR="$ROOT/config/whitelabel/clients"
else
  CLIENTS_DIR="$ROOT/config/clients"
fi
LINK="$ROOT/config/config.yml"
MARKER="$ROOT/config/.active-client"

usage() { sed -n '3,27p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

active_name() { [[ -f "$MARKER" ]] && cat "$MARKER" || true; }

# True if config/config.yml is managed by us (a symlink, or a copy we recorded).
managed() { [[ -L "$LINK" || ( -e "$LINK" && -f "$MARKER" ) ]]; }

list_clients() {
  local found=0 active
  active="$(active_name)"
  shopt -s nullglob
  for f in "$CLIENTS_DIR"/*.yml; do
    found=1
    local name="" marker=""
    name="$(basename "$f" .yml)"
    [[ -n "$active" && "$name" == "$active" ]] && marker="  <- active"
    printf '  %s%s\n' "$name" "$marker"
  done
  shopt -u nullglob
  if [[ "$found" -eq 0 ]]; then
    echo "  (none yet — add <name>.yml to ${CLIENTS_DIR#"$ROOT/"})"
  fi
}

current_client() {
  local active
  active="$(active_name)"
  if [[ -n "$active" ]]; then
    echo "$active"
  elif [[ -L "$LINK" ]]; then
    basename "$(readlink "$LINK")" .yml
  elif [[ -e "$LINK" ]]; then
    echo "(config/config.yml is an unmanaged file)"
  else
    echo "(none)"
  fi
}

case "${1:-}" in
  ""|-h|--help)
    usage
    ;;
  --list|-l)
    echo "Available client configs in ${CLIENTS_DIR#"$ROOT/"}:"
    list_clients
    ;;
  --current|-c)
    echo "Active client: $(current_client)"
    ;;
  --clear)
    if managed; then
      rm -f "$LINK" "$MARKER"
      echo "Cleared active client (removed config/config.yml)."
    elif [[ -e "$LINK" ]]; then
      echo "Refusing to remove config/config.yml — it is not managed by use-client." >&2
      exit 1
    else
      rm -f "$MARKER"
      echo "No config/config.yml to clear."
    fi
    ;;
  -*)
    echo "Unknown option: $1" >&2
    echo >&2
    usage >&2
    exit 1
    ;;
  *)
    NAME="$1"
    TARGET="$CLIENTS_DIR/$NAME.yml"
    if [[ ! -f "$TARGET" ]]; then
      echo "No such client config: $TARGET" >&2
      echo >&2
      echo "Available:" >&2
      list_clients >&2
      exit 1
    fi
    # Only refuse if config/config.yml is someone's own file (unmanaged).
    if [[ -e "$LINK" ]] && ! managed; then
      echo "config/config.yml exists and isn't managed by use-client — refusing to overwrite." >&2
      echo "Move/remove it (or run: bin/use-client --clear) first." >&2
      exit 1
    fi

    rm -f "$LINK"
    if ln -s "$TARGET" "$LINK" 2>/dev/null && [[ -L "$LINK" ]]; then
      method="symlink"
    else
      rm -f "$LINK"
      cp "$TARGET" "$LINK"
      method="copy"
    fi
    printf '%s\n' "$NAME" > "$MARKER"

    echo "Active client -> $NAME  ($method: config/config.yml <- $TARGET)"
    if [[ "$method" == "copy" ]]; then
      echo "(symlinks unavailable here — copied instead; re-run after editing the config.)"
    fi
    echo "Restart the server to apply."
    ;;
esac
