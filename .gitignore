/.bundle

/db/*.sqlite3
/db/*.sqlite3-*

/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

/config/master.key
/config/config.yml
/config/.active-client

# Per-client white-label configs — kept out of git on purpose.
# Drop one file per client in config/clients/ (e.g. parcours.yml) and switch
# between them with `bin/use-client`. Templates/docs are committed.
/config/clients/*
!/config/clients/README.md
!/config/clients/.keep

# Per-client brand images — also kept private (mounted in prod, local in dev).
# Drop one folder per client in public/brands/<client>/ (logo, favicons, …).
/public/brands/*
!/public/brands/README.md
!/public/brands/.keep

/public/packs
/public/packs-test
/node_modules
/yarn-error.log
yarn-debug.log*
.yarn-integrity

.env
.DS_Store

/coverage
/attachments
/docuseal
/ee
dump.rdb
*.onnx
pg_data/
caddy/
docuseal/
.env
